NODE_ENV=production
PORT=3001
# Keep Node private; Caddy proxies public HTTP(S) traffic to this listener.
HOST=127.0.0.1
# Keep empty for same-origin only; otherwise comma-separated browser origins.
APP_ORIGIN=
# Optional cross-origin A/B mapping; use only an explicitly approved HTTPS endpoint.
# Example: {"render-ab":"https://kafatopu.onrender.com"}
GAME_ENDPOINTS_JSON={}
# Generate only on the VM. The metrics endpoint is hidden without this value.
METRICS_TOKEN=REPLACE_ON_VM_ONLY
